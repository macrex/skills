{
  "modules": [
    "./register.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/vault-rules.js\" SessionStart",
            "timeout": 5,
            "statusMessage": "Carregando as regras do vault..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/grill-canal.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?!.*vault-migrador$)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/vault-rules.js\" SubagentStart",
            "timeout": 5,
            "statusMessage": "Carregando as regras do vault..."
          }
        ]
      }
    ]
  }
}
